# secrets - never commit
.env
.env.*
!.env.example

# Ignore EVERYTHING under .streamlit, then allow back the two files that are
# safe to publish. A denylist kept missing new filenames; this cannot.
.streamlit/*
!.streamlit/config.toml
!.streamlit/secrets.toml.example

# local database file (SQLite fallback)
haircut.db

# python
__pycache__/
*.pyc
.venv/

# screenshots and scratch images - these routinely contain credentials
*.png
*.jpg
*.jpeg
*.gif
*.webp
