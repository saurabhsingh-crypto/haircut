# secrets - never commit
.env
.env.*
!.env.example
# every secrets variant, including working copies, EXCEPT the template
.streamlit/secrets.toml
.streamlit/secrets.toml.*
!.streamlit/secrets.toml.example

# local database file (SQLite fallback)
haircut.db

# python
__pycache__/
*.pyc
.venv/

# screenshots and scratch images - these routinely contain credentials
*.png
*.jpg
*.jpeg
*.gif
*.webp
