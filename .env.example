# Copy this file to `.env` and fill in your real password.
# `.env` is git-ignored and must NEVER be committed.
#
# Leave every line commented out to run on the local SQLite file instead.

HAIRCUT_DB_HOST=127.0.0.1
HAIRCUT_DB_PORT=3306
HAIRCUT_DB_USER=root
HAIRCUT_DB_PASSWORD=your_mysql_password_here
HAIRCUT_DB_NAME=haircut
