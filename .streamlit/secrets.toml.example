# Copy to `.streamlit/secrets.toml`, or paste these keys into the hosted
# app's secrets box (Manage app -> Settings -> Secrets).
#
# TOML ORDERING MATTERS: plain keys must come BEFORE any [table] header.
# Everything after `[auth]` belongs to `[auth]`, so the HAIRCUT_* settings
# have to sit above it. Keep [auth] last when you edit this file.

# =========================================================================== #
# Who may sign in
#
# Your identity provider will authenticate any account it is willing to; this
# allowlist is what actually restricts access. Both keys empty means nobody
# gets in - the app fails closed, not open.
# =========================================================================== #

HAIRCUT_ALLOWED_DOMAINS = "yourcompany.com"
# HAIRCUT_ALLOWED_EMAILS = "someone@gmail.com,contractor@other.com"
# Administrators: who may see the Diagnostics page and delete saved masters.
# A strict subset of the allowlist above - the allowlist decides who gets in,
# this decides who gets the destructive controls. Empty grants nobody.
HAIRCUT_ADMIN_EMAILS = "you@yourcompany.com"


# =========================================================================== #
# Database 
# =========================================================================== #

HAIRCUT_DB_HOST = "your-mysql-host"
HAIRCUT_DB_PORT = "3306"
HAIRCUT_DB_USER = "root"
HAIRCUT_DB_PASSWORD = "your-mysql-password"
HAIRCUT_DB_NAME = "haircut"

# Local MySQL on 127.0.0.1 does not need TLS. Pointing this at a hosted
# database, add ONE of these:
# HAIRCUT_DB_SSL_CA = "certs/mysql-ca.pem"   # preferred - verifies the server
# HAIRCUT_DB_SSL = "1"                       # encrypted, unverified

# Leave off locally so the SQLite fallback still works if MySQL is down.
# Set to "1" on the hosted app so a missing secret cannot silently lose data.
# HAIRCUT_REQUIRE_MYSQL = "1"

# =========================================================================== #
# Skip sign-in entirely while working locally.
# Uncomment to run with no OAuth client at all. NEVER set this when hosted.
# =========================================================================== #

# HAIRCUT_ALLOW_ANONYMOUS = "1"

# =========================================================================== #
# Single sign-on - KEEP THIS BLOCK LAST
#
# Paste the two values from your OAuth client below.
#   Google: console.cloud.google.com -> APIs & Services -> Credentials
#           -> Create Credentials -> OAuth client ID -> Web application
#           Authorised redirect URI: http://localhost:8501/oauth2callback
#
# Until client_id and client_secret are real, the app shows a setup screen
# naming exactly what is missing, and lets nobody in.
# =========================================================================== #

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "run: python -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "PASTE_CLIENT_ID_HERE"
client_secret = "PASTE_CLIENT_SECRET_HERE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# For Microsoft Entra ID, replace server_metadata_url with:
# server_metadata_url = "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration"
